{
  "name": "acme-blms",
  "private": true,
  "version": "1.0.6",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --port=5173 --host=0.0.0.0",
    "build": "vite build && esbuild server/index.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist-server/index.cjs",
    "start": "NODE_ENV=production node dist-server/index.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "seed:generate": "tsx scripts/generate-seed.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@vitejs/plugin-react": "6.3.0",
    "dotenv": "17.4.2",
    "exceljs": "4.4.0",
    "express": "4.22.3",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.9",
    "lucide-react": "0.546.0",
    "motion": "12.43.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.8"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.7.0",
    "concurrently": "10.0.7",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "description": "Acme Group Business Licenses Monitoring System",
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
